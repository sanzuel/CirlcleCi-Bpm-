.circle/config.yml
version: 2.1

jobs:
  build:
    docker:
      - image: cimg/android:2025.05
    steps:
      - checkout
      - run:
          name: Show Java and Gradle
          command: |
            java -version
            gradle --version
      - run:
          name: Build Android APK
          command: gradle :app:assembleDebug --no-daemon
      - store_artifacts:
          path: app/build/outputs/apk/debug/app-debug.apk
          destination: SongSetlist-debug.apk

workflows:
  build_android:
    jobs:
      - build
